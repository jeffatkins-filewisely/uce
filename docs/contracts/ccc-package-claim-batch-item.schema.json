{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filewisely.com/contracts/ccc-package-claim-batch.item.json",
  "title": "ccc-package-claim-batch response item",
  "type": "object",
  "required": ["queue_id", "source_table", "source_id"],
  "properties": {
    "queue_id": { "type": "string", "format": "uuid" },
    "action_type": {
      "type": "string",
      "enum": ["mirror_file", "delete_folder", "delete_file", "archive_folder"],
      "default": "mirror_file",
      "description": "Job kind; omit for legacy mirror-only payloads"
    },
    "ro_folder": { "type": "string", "description": "Alias: ro_folder_name (mirror_file)" },
    "ro_folder_name": { "type": "string" },
    "sub_folder": {
      "type": "string",
      "description": "Relative path under RO root, e.g. photos/check_in, estimates, payments"
    },
    "bucket": {
      "type": "string",
      "description": "Legacy photo bucket when sub_folder absent"
    },
    "filename_hint": { "type": "string", "description": "Alias: filename" },
    "filename": { "type": "string" },
    "signed_url": { "type": "string", "format": "uri" },
    "target_path_hint": {
      "type": "string",
      "description": "RO folder name under CCC Import root (delete_folder)"
    },
    "source_table": { "type": "string" },
    "source_id": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action_type": { "const": "delete_folder" } },
        "required": ["action_type"]
      },
      "then": { "required": ["target_path_hint"] }
    },
    {
      "if": {
        "not": { "properties": { "action_type": { "const": "delete_folder" } } }
      },
      "then": { "required": ["signed_url"] }
    }
  ]
}
