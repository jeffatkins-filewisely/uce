{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UCE",
  "version": "0.1.5",
  "identifier": "com.filewisely.uce",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UCE — Universal Capture Engine",
        "width": 58,
        "height": 38,
        "minWidth": 1,
        "minHeight": 1,
        "maxWidth": 700,
        "maxHeight": 2000,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "transparent": true,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },

  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jeffatkins-filewisely/uce/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQTVENzcyMDdFRTI5NzAKUldSd0tlNEhjdGVsdkhYelR6SERUempDUGxqeFV5ZTFPcDJrQUVJckJBTUR5T1hwcG1rM0NGZkMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}